			<staticText>
				<reportElement mode="Opaque" x="160" y="1578" width="470" height="52" backcolor="#C4C1C0" uuid="88ae94b7-c502-4670-abca-7b553d24a753">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[We have a BCMS system and back up of data is done twice a day. 
As per our BCMS system, in case of a downtime, the maximum recovery time for Finacle is 0.5 days. 
We also have a Disaster Recovery site.]]></text>
			</staticText>
