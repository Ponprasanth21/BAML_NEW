	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="420">
			<staticText>
				<reportElement x="0" y="-20" width="850" height="30" forecolor="#3106BF" uuid="cc060211-d3a7-4521-bf99-a03ac9c9ca6d"/>
				<box>
					<pen lineWidth="1.25" lineColor="#0A051A"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[Templates for compiling and submission of data on NBDTIs' exposures to ML/TF risk ]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="372" width="850" height="48" uuid="cfa53f72-e09a-4676-ac72-d258aab555f6">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="1.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="11"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<text><![CDATA[10. NBDTIs should be guided by the reporting rules provided under the relevant Tables, which also include definitions of certain terms, examples and explanations. In spite of the above, if in case NBDTIs' officials compiling the returns have to seek any clarifications these may be addressed by email at rbs@bom.mu.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="342" width="850" height="30" uuid="9fee3c12-c5c9-43d8-9d15-cd631dd1aa68">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="1.25"/>
				</box>
				<textElement verticalAlignment="Middle" markup="styled">
					<font size="11"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<text><![CDATA[9.  The templates should be submitted to the Bank by email at <style isUnderline="true">rbs@bom.mu</style>]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="312" width="850" height="30" uuid="f1d001f3-4572-49a5-8b20-c3bc388711fc">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="1.25"/>
				</box>
				<textElement verticalAlignment="Middle" markup="styled">
					<font size="11"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<text><![CDATA[8. Going forward, NBDTIs should compile these templates on an ongoing basis with reference to the position as on the last day of each calendar quarter, and arrange to submit these to the Bank within <style isBold='true'>25 working days</style> from the reference date.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="282" width="850" height="30" uuid="6ef89d71-ec9a-41bf-8432-b15bc72a03e1">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="1.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="11"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<text><![CDATA[7. NBDTIs should compile these templates as from the quarter ending December 2019.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="252" width="850" height="30" uuid="9069a790-a03d-47c2-9417-df6757a49931">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="1.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="11"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<text><![CDATA[6. In case a table is not relevant for an institution, it should indicate 'Nil return' above that table. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="180" width="850" height="42" uuid="4a794bed-cf7b-473e-8b28-876698612635">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="1.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="11"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<text><![CDATA[DISCLAIMER: Whilst every effort has been made to provide complete, accurate and credible data to the Bank of Mauritius, the Head of Compliance and the Chief Risk Officer makes no warranties, express or implied, or representations as to the completeness, accuracy and credibility of the data provided on these RBS TEMPLATES FOR NBDTIs.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="150" width="850" height="30" uuid="0d3487ad-201b-4311-bf2c-beefbe0f8fc5">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="1.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="11" isBold="true" isItalic="true"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<text><![CDATA[4. The completed templates should be carefully reviewed by the Head of Compliance and the Chief Risk Officer, before submission to Bank, to ensure accuracy and credibility of the data furnished to Bank.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="120" width="850" height="30" uuid="9fb9e763-7f48-44ff-8fee-acd824854642">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="1.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="11"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<text><![CDATA[3. The completed templates should be carefully verified and checked by a person other than the one who has compiled the templates.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="90" width="850" height="30" uuid="48e5bbef-4f50-4719-b18b-1d7f2232994a">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="1.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="11"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<text><![CDATA[2. The officials compiling the templates should ensure that the validation errors or messages flagged in the templates are addressed and avoid submitting templates with errors.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="40" width="850" height="50" uuid="c7f2c682-3b8b-4541-a398-9a7a1108ad6f">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="1.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="12"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<text><![CDATA[1. The NBDTI should identify a team of officials who will compile the templates, and who will be able to provide all required follow-up clarifications and updates to the Bank. Their names and contact details should be advised to the Bank while submitting the completed templates.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="10" width="850" height="30" forecolor="#3106BF" uuid="dc3e0891-fceb-4401-af5c-cef2d8ff645c"/>
				<box>
					<pen lineWidth="1.25" lineColor="#0A051A"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[Instructions]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="222" width="850" height="30" uuid="abcd454d-916e-40a0-9107-079ecb1762d8">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="1.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="11"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<text><![CDATA[5. As the templates have inbuilt validations and aggregations, the NBDTIs are advised to use the same template to submit their data compilations to the Bank.]]></text>
			</staticText>
		</band>
	</detail>
</jasperReport>
